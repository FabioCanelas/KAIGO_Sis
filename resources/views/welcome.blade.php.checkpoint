    <!-- Script para Sticky Horizontal Scroll -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const wrapper = document.getElementById('destacados-wrapper');
            const slider = document.getElementById('destacados-slider');
            
            if (wrapper && slider) {
                let ticking = false;
                
                window.addEventListener('scroll', () => {
                    if (!ticking) {
                        window.requestAnimationFrame(() => {
                            const rect = wrapper.getBoundingClientRect();
                            const windowHeight = window.innerHeight;

                            // 80px es el tamaño del header (top-20) donde se queda pegado
                            const stickyTop = 80; 
                            
                            // Si el wrapper está tocando o ha sobrepasado el header, y aún no ha terminado
                            if (rect.top <= stickyTop && rect.bottom >= windowHeight) {
                                // maxScrollVertical es toda el área en la que el usuario estará atascado scrolleando
                                const maxScrollVertical = wrapper.offsetHeight - windowHeight;
                                // Cuánto hemos bajado desde que se pegó
                                const scrolledDistance = stickyTop - rect.top;
                                
                                const progress = Math.min(Math.max(scrolledDistance / maxScrollVertical, 0), 1);
                                const maxScrollLeft = slider.scrollWidth - slider.clientWidth;
                                
                                slider.scrollLeft = maxScrollLeft * progress;
                            }
                            // Si scrolleó muy rápido hacia arriba
                            else if (rect.top > stickyTop) {
                                slider.scrollLeft = 0;
                            }
                            // Si scrolleó muy rápido hacia abajo pasando la sección
                            else if (rect.bottom < windowHeight) {
                                slider.scrollLeft = slider.scrollWidth - slider.clientWidth;
                            }
                            
                            ticking = false;
                        });
                        ticking = true;
                    }
                });
            }
        });
        // Lógica para la sección Spaces Parallax (Sticky + Sequence)
        const spacesWrapper = document.getElementById('spaces-wrapper');
        const spacesSticky = document.getElementById('catalogo-visual');
        const btnSpaces = document.getElementById('spaces-btn');
        
        const imgGroup1 = document.querySelectorAll('.img-group-1');
        const imgGroup2 = document.querySelectorAll('.img-group-2');
        const imgGroup3 = document.querySelectorAll('.img-group-3');

        if (spacesWrapper && spacesSticky) {
            let tickingSpaces = false;
            
            // Función auxiliar para mapear un rango de progreso [min, max] a [0, 1]
            const mapProgress = (prog, min, max) => {
                if (prog <= min) return 0;
                if (prog >= max) return 1;
                return (prog - min) / (max - min);
            };

            // Función para animar un grupo de imágenes
            const animateGroup = (group, progress) => {
                // scale va de 0.5 a 1
                const scale = 0.5 + (0.5 * progress);
                // opacity va de 0 a 1
                group.forEach(img => {
                    img.style.transform = `scale(${scale})`;
                    img.style.opacity = progress;
                });
            };

            const updateSpaces = () => {
                const rect = spacesWrapper.getBoundingClientRect();
                const wrapperHeight = spacesWrapper.offsetHeight;
                const stickyHeight = spacesSticky.offsetHeight;
                const maxScroll = wrapperHeight - stickyHeight;
                
                // Cuánto hemos scrolleado dentro del wrapper (desde que el sticky toca arriba)
                let scrolled = -rect.top;
                
                let progress = scrolled / maxScroll;
                progress = Math.max(0, Math.min(1, progress));

                // Secuencia de animaciones:
                // Grupo 1: 0.0 a 0.3
                const p1 = mapProgress(progress, 0.0, 0.3);
                animateGroup(imgGroup1, p1);

                // Grupo 2: 0.3 a 0.6
                const p2 = mapProgress(progress, 0.3, 0.6);
                animateGroup(imgGroup2, p2);

                // Grupo 3: 0.6 a 0.9
                const p3 = mapProgress(progress, 0.6, 0.9);
                animateGroup(imgGroup3, p3);

                // Botón: 0.9 a 1.0
                if (progress > 0.9) {
                    btnSpaces.style.opacity = '1';
                    btnSpaces.style.transform = 'translateY(0)';
                    btnSpaces.classList.remove('pointer-events-none');
                } else {
                    btnSpaces.style.opacity = '0';
                    btnSpaces.style.transform = 'translateY(40px)';
                    btnSpaces.classList.add('pointer-events-none');
                }
            };

            window.addEventListener('scroll', () => {
                if (!tickingSpaces) {
                    window.requestAnimationFrame(() => {
                        updateSpaces();
                        tickingSpaces = false;
                    });
                    tickingSpaces = true;
                }
            });
            updateSpaces();
        }
    </script>
</body></html>